# ===========================================================================
# Phonix - template for .env. Committed; contains NO real secrets.
#
#   copy .env.example -> .env   then fill in the blanks.
#
# Nesting uses a DOUBLE underscore: PHONIX__DATABASE__PASSWORD -> database.password
# ===========================================================================

PHONIX_ENV=development

# --- PostgreSQL (baremetal) ------------------------------------------------
PHONIX__DATABASE__HOST=localhost
PHONIX__DATABASE__PORT=5432
PHONIX__DATABASE__USERNAME=
PHONIX__DATABASE__PASSWORD=

# Percent-encode any of : / ? # [ ] @ that appear in the password.
# '@' -> %40   ':' -> %3A   '#' -> %23   '/' -> %2F
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/phonix_catalog
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=

# --- Redis (docker) --------------------------------------------------------
PHONIX__REDIS__HOST=127.0.0.1
PHONIX__REDIS__PORT=6379
PHONIX__REDIS__PASSWORD=
REDIS_PASSWORD=
REDIS_PORT=6379

# --- RabbitMQ (docker) -----------------------------------------------------
PHONIX__RABBITMQ__HOST=127.0.0.1
PHONIX__RABBITMQ__PORT=5672
PHONIX__RABBITMQ__VHOST=phonix
PHONIX__RABBITMQ__USERNAME=phonix
PHONIX__RABBITMQ__PASSWORD=
RABBITMQ_USER=phonix
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=phonix
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Mail (system-default relay) -------------------------------------------
# Development uses the Mailtrap sandbox: sandbox.smtp.mailtrap.io, port 2525.
# Both values come from the inbox's "SMTP Settings" tab in Mailtrap.
# A workspace can override all of this in its own settings panel.
PHONIX__SMTP__USERNAME=
PHONIX__SMTP__PASSWORD=

# --- Logging ---------------------------------------------------------------
# RUST_LOG=phonix=debug
RUST_BACKTRACE=1

# --- Leptos ----------------------------------------------------------------
LEPTOS_SITE_ADDR=127.0.0.1:3000
